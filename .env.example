# ==============================================================================
# OpsAI Platform — Centralized Environment Configuration
# ==============================================================================
# All configuration is managed here in ONE SINGLE PLACE.
# Docker Compose automatically loads this file.

# --- PostgreSQL Database (Your Local Machine) ---
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# --- Redis Cache ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Apache Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Security / JWT ---
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# --- JVM Memory Limits (Per Service) ---
JAVA_OPTS=-Xms128m -Xmx256m
